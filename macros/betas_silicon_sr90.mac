# =============================================================================
# betas_silicon_sr90.mac
#
# Beta electrons from a Sr-90 / Y-90 source (the standard high-energy lab
# beta source) into a three-layer silicon tracker. Sr-90 and its daughter
# Y-90 are in secular equilibrium, giving two superimposed continuous beta
# spectra with endpoints 0.546 MeV (Sr-90) and 2.28 MeV (Y-90). The arb
# histogram below approximates the combined emitted electron spectrum using
# the allowed beta shape N(E) ~ p (E+mc^2) (Q-E)^2 (equal activity, Fermi
# correction neglected). The hard Y-90 component (up to 2.28 MeV) punches
# through all three 300 um layers; softer betas stop earlier.
#
# Detector: gdml/silicon_3layer.gdml
#   - World:  20x20x20 cm (G4_AIR)
#   - Layers: 3 x 10x10 cm G4_Si, 300 um thick, 300 um gaps
#             (centres at z = 0.15, 0.75, 1.35 mm; entrance at z = 0)
#
# Beam:
#   - Particle : e-  (beta-minus)
#   - Energy   : Sr-90/Y-90 beta spectrum (arb histogram, 0.05-2.25 MeV)
#   - Position : 2 cm upstream on the beam axis
#   - Direction: along +z
#
# Per-layer energy deposit (in ROOT/uproot; layer centres in mm):
#   layer0: step_edep where abs(step_z-0.15)<0.15 ; similarly 0.75, 1.35
# or just run `g4tp analyze output.root` / `g4tp display output.root --gdml ...`.
# =============================================================================

# --- Load geometry ---
/detector/readGDML gdml/silicon_3layer.gdml

# --- Physics ---
/run/initialize

# --- Beam: Sr-90/Y-90 beta spectrum ---
/gun/particle    e-
/gun/energyMode  arb
/gun/clearEnergyBins
/gun/addEnergyBin 0.050 MeV 0.718
/gun/addEnergyBin 0.150 MeV 1.000
/gun/addEnergyBin 0.250 MeV 0.908
/gun/addEnergyBin 0.350 MeV 0.626
/gun/addEnergyBin 0.450 MeV 0.318
/gun/addEnergyBin 0.550 MeV 0.186
/gun/addEnergyBin 0.650 MeV 0.203
/gun/addEnergyBin 0.750 MeV 0.215
/gun/addEnergyBin 0.850 MeV 0.221
/gun/addEnergyBin 0.950 MeV 0.223
/gun/addEnergyBin 1.050 MeV 0.220
/gun/addEnergyBin 1.150 MeV 0.211
/gun/addEnergyBin 1.250 MeV 0.199
/gun/addEnergyBin 1.350 MeV 0.182
/gun/addEnergyBin 1.450 MeV 0.161
/gun/addEnergyBin 1.550 MeV 0.138
/gun/addEnergyBin 1.650 MeV 0.114
/gun/addEnergyBin 1.750 MeV 0.088
/gun/addEnergyBin 1.850 MeV 0.063
/gun/addEnergyBin 1.950 MeV 0.041
/gun/addEnergyBin 2.050 MeV 0.021
/gun/position    0 0 -2 cm
/gun/direction   0 0 1

# --- Run ---
/run/printProgress 200
/run/beamOn 2000
