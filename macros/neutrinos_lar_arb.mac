# =============================================================================
# neutrinos_lar_arb.mac
#
# Shoot a muon-neutrino beam with a user-defined arbitrary energy distribution
# at the 1 m³ liquid-argon target.
#
# The distribution below roughly mimics a broad accelerator neutrino flux
# peaking around 1-3 GeV.
#
# Detector: gdml/liquid_argon_1m3.gdml
#   - World:  200×200×200 cm (G4_AIR)
#   - Target: 100×100×100 cm liquid argon, centred at the origin
#
# Beam:
#   - Particle : nu_mu  (muon neutrino)
#   - Energy   : arbitrary histogram (see bins below)
#   - Position : upstream on the beam axis (z = -60 cm)
#   - Direction: along +z
# =============================================================================

# --- Load geometry ---
/detector/readGDML gdml/liquid_argon_1m3.gdml

# --- Neutrino physics ---
/physics_lists/em/NuDetectorName DefaultRegionForTheWorld
/physics_lists/em/NeutrinoActivation true
/physics_lists/em/NuEleCcBias   5e12
/physics_lists/em/NuEleNcBias   5e12
/physics_lists/em/NuNucleusBias 5e12

# --- Physics initialise ---
/run/initialize

# --- Emit the nu_* neutrino-interaction branches ---
/analysis/neutrinoMode on

# --- Beam ---
/gun/particle    nu_mu
/gun/energyMode  arb
/gun/position    0 0 -60 cm
/gun/direction   0 0 1

# Define the arbitrary energy histogram.
# Syntax: /gun/addEnergyBin <energy> <unit> <relativeWeight>
# Weights need not be normalised; the generator normalises internally.
/gun/clearEnergyBins
/gun/addEnergyBin  200 MeV 1.0
/gun/addEnergyBin  500 MeV 2.5
/gun/addEnergyBin    1 GeV 5.0
/gun/addEnergyBin    2 GeV 6.0
/gun/addEnergyBin    3 GeV 4.5
/gun/addEnergyBin    5 GeV 2.0
/gun/addEnergyBin   10 GeV 0.5

# --- Run ---
/run/printProgress 100
/run/beamOn 1000
