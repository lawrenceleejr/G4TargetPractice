# =============================================================================
# neutrinos_lar_mono.mac
#
# Shoot a monoenergetic 2 GeV muon-neutrino beam at the 1 m³ liquid-argon
# target.  Neutrino interaction biasing is enabled so that at least a few
# interactions are recorded in a short run.
#
# Detector: gdml/liquid_argon_1m3.gdml
#   - World:  200×200×200 cm (G4_AIR)
#   - Target: 100×100×100 cm liquid argon, centred at the origin
#
# Beam:
#   - Particle : nu_mu  (muon neutrino)
#   - Energy   : 2 GeV  (monoenergetic)
#   - Position : upstream on the beam axis (z = -60 cm)
#   - Direction: along +z
# =============================================================================

# --- Load geometry ---
/detector/readGDML gdml/liquid_argon_1m3.gdml

# --- Neutrino physics ---
/physics_lists/em/NuDetectorName DefaultRegionForTheWorld
/physics_lists/em/NeutrinoActivation true
/physics_lists/em/NuEleCcBias   5e12
/physics_lists/em/NuEleNcBias   5e12
/physics_lists/em/NuNucleusBias 5e12

# --- Physics initialise ---
/run/initialize

# --- Emit the nu_* neutrino-interaction branches (auto would also enable
#     these for a neutrino primary; set explicitly for clarity) ---
/analysis/neutrinoMode on

# --- Beam ---
/gun/particle    nu_mu
/gun/energyMode  mono
/gun/energy      2 GeV
/gun/position    0 0 -60 cm
/gun/direction   0 0 1

# --- Run ---
/run/printProgress 100
/run/beamOn 1000
