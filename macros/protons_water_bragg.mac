# =============================================================================
# protons_water_bragg.mac
#
# Pristine proton Bragg peak: shoot a monoenergetic 150 MeV proton pencil
# beam into a water phantom. The depth-dose curve shows the characteristic
# Bragg peak at ~15.6 cm depth (CSDA range of 150 MeV protons in water).
#
# Detector: gdml/water_phantom_30cm.gdml
#   - World:   60×60×100 cm (G4_AIR)
#   - Phantom: 30×30 cm water tank, 40 cm deep, entrance face at z = 0
#              (depth in water = z)
#
# Beam:
#   - Particle : proton
#   - Energy   : 150 MeV (monoenergetic, typical therapy energy)
#   - Position : upstream on the beam axis (z = -20 cm)
#   - Direction: along +z
#
# Depth-dose extraction (in ROOT, z in mm, edep in MeV):
#   tree->Draw("step_z>>h(200,0,400)", "step_edep")
# =============================================================================

# --- Load geometry ---
/detector/readGDML gdml/water_phantom_30cm.gdml

# --- Physics ---
/run/initialize

# --- Beam ---
/gun/particle    proton
/gun/energyMode  mono
/gun/energy      150 MeV
/gun/position    0 0 -20 cm
/gun/direction   0 0 1

# --- Run ---
/run/printProgress 100
/run/beamOn 1000
