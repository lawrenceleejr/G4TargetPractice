# Compiled binaries / objects
# NOTE: do NOT add a bare "g4sim" pattern here — it would shadow the g4sim/
# source directory. The built executable lives under build/ (already ignored).
neutrino
*.o
*.a
*.so
*.dylib
*.dll
*.exe
*.out

# Geant4 data/source directories (downloaded inside container)
geant4-data/
geant4-source/
geant4-build/
geant4-install/

# Geant4 / ROOT output files
*.root
*.rndm
*.wrl
*.heprep
*.prim
G4*.dat

