<?xml version="1.0"?>
<!--
  Water phantom for medical-physics dose studies.

  World:   60 x 60 x 100 cm air box centred at the origin.
  Phantom: 30 x 30 cm water tank, 40 cm deep along z.
           The entrance face is at z = 0, so depth in water = z.

  Aim the beam along +z from negative z (e.g. /gun/position 0 0 -20 cm).
-->
<gdml>
  <solids>
    <box name="WorldBox" x="60" y="60" z="100" lunit="cm"/>
    <box name="WaterBox" x="30" y="30" z="40"  lunit="cm"/>
  </solids>

  <structure>
    <volume name="WaterPhantom_vol">
      <materialref ref="G4_WATER"/>
      <solidref ref="WaterBox"/>
    </volume>

    <volume name="World">
      <materialref ref="G4_AIR"/>
      <solidref ref="WorldBox"/>
      <physvol>
        <volumeref ref="WaterPhantom_vol"/>
        <position x="0" y="0" z="20" unit="cm"/>
      </physvol>
    </volume>
  </structure>

  <setup name="Default" version="1.0">
    <world ref="World"/>
  </setup>
</gdml>
